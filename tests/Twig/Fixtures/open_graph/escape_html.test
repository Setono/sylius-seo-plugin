--TEST--
OpenGraph escapes HTML entities in content
--TEMPLATE--
{% do openGraph.title('Title with "quotes" & <special> chars') %}
{{ setono_sylius_seo_render_open_graph() }}
--DATA--
return [];
--EXPECT--
<meta property="og:title" content="Title with &quot;quotes&quot; &amp; &lt;special&gt; chars">
<meta property="og:type" content="website">
