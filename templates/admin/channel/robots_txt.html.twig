<div class="g-col-12 card mb-3">
    <div class="card-header">
        <div class="card-title">{{ 'setono_sylius_seo.ui.robots_txt'|trans }}</div>
    </div>

    <div class="card-body">
        {% set existing = setono_sylius_seo_existing_robots_txt() %}
        {% if existing %}
            <div class="alert alert-danger" role="alert">
                <h4 class="alert-heading">{{ 'setono_sylius_seo.ui.robots_txt_exists'|trans }}</h4>
                <p>{{ 'setono_sylius_seo.ui.robots_txt_exists_body'|trans }}</p>
                <pre class="mb-0">{{ existing }}</pre>
            </div>
        {% endif %}

        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">{{ 'setono_sylius_seo.ui.robots_txt_twig_heading'|trans }}</h4>
            <p>{{ 'setono_sylius_seo.ui.robots_txt_twig_info'|trans }}</p>

            <p class="mb-1"><strong>{{ 'setono_sylius_seo.ui.robots_txt_twig_example_sitemap'|trans }}</strong></p>
            <pre class="mb-3">{% verbatim %}Sitemap: {{ absolute_url('/sitemap.xml') }}{% endverbatim %}</pre>

            <p class="mb-1"><strong>{{ 'setono_sylius_seo.ui.robots_txt_twig_example_environment'|trans }}</strong></p>
            <pre class="mb-3">{% verbatim %}{% if app.environment != 'prod' %}
User-agent: *
Disallow: /
{% endif %}{% endverbatim %}</pre>

            <p class="mb-1"><strong>{{ 'setono_sylius_seo.ui.robots_txt_twig_example_route'|trans }}</strong></p>
            <pre class="mb-0">{% verbatim %}Sitemap: {{ url('sylius_shop_homepage') }}{% endverbatim %}</pre>
        </div>

        {{ form_row(hookable_metadata.context.form.robotsTxt) }}
    </div>
</div>
